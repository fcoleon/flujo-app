limit_req_zone $binary_remote_addr zone=flujo_login:10m rate=5r/m;

server {
    listen 80;
    server_name @@SERVER_NAME@@;

    # BEGIN flujo-app assets
    location ^~ /static/ {
        alias @@APP_DIR@@/static/;
        add_header Cache-Control "no-cache";
    }
    # END flujo-app assets

    location = /api/login {
        limit_req zone=flujo_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:@@SOCKET_PATH@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Servidor MCP de solo lectura; otro socket Unix y otro proceso.
    location = /mcp {
        proxy_pass http://unix:@@MCP_SOCKET_PATH@@;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # La aplicación escucha en un socket Unix local, accesible para Nginx.
    location / {
        proxy_pass http://unix:@@SOCKET_PATH@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
