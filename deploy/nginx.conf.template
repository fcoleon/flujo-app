server {
    listen 80;
    server_name @@SERVER_NAME@@;

    # BEGIN flujo-app assets
    location ~ "^/assets/(style\.[0-9a-f]{16}\.css|app\.[0-9a-f]{16}\.js|favicon\.[0-9a-f]{16}\.svg)$" {
        root /var/lib/flujo-app;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }
    # END flujo-app assets

    # La aplicación escucha en un socket Unix local, accesible para Nginx.
    location / {
        proxy_pass http://unix:@@SOCKET_PATH@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
