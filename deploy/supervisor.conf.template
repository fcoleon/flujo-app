[program:flujo-app]
directory=@@APP_DIR@@
command=@@APP_DIR@@/.venv/bin/gunicorn --config @@APP_DIR@@/deploy/gunicorn.conf.py app:app
user=@@APP_USER@@
environment=APP_CONFIG="@@CONFIG_PATH@@",FLUJO_CONFIG_ONLY="1",FLUJO_BEHIND_PROXY="1",PYTHONUNBUFFERED="1"
autostart=true
autorestart=true
priority=100
startsecs=3
stopsignal=TERM
stopasgroup=true
killasgroup=true
stdout_logfile=/var/log/supervisor/flujo-app.out.log
stderr_logfile=/var/log/supervisor/flujo-app.err.log
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
stdout_logfile_backups=3
stderr_logfile_backups=3

[program:flujo-slack]
directory=@@APP_DIR@@
command=@@APP_DIR@@/.venv/bin/python @@APP_DIR@@/slack_notify.py
user=@@APP_USER@@
environment=APP_CONFIG="@@CONFIG_PATH@@",FLUJO_CONFIG_ONLY="1",FLUJO_BEHIND_PROXY="1",PYTHONUNBUFFERED="1"
autostart=true
autorestart=true
priority=200
startsecs=0
stopsignal=TERM
stopasgroup=true
killasgroup=true
stdout_logfile=/var/log/supervisor/flujo-slack.out.log
stderr_logfile=/var/log/supervisor/flujo-slack.err.log
stdout_logfile_maxbytes=10MB
stderr_logfile_maxbytes=10MB
stdout_logfile_backups=3
stderr_logfile_backups=3
